{
  "version": "0.1",
  "packs": [
    {
      "id": "dev",
      "group": "role",
      "label": "Developer",
      "description": "Requirements, design, implement, tests, refactor, debug, review, commit, pull requests, dependencies, releases"
    },
    {
      "id": "tester",
      "group": "role",
      "label": "Tester",
      "description": "Test plans, test cases, automation, test runs, bug reports, regression, traceability"
    },
    {
      "id": "spring-boot",
      "group": "profile",
      "label": "Spring Boot",
      "description": "Layering, DTOs, validation, transactions, N+1 queries, slice tests",
      "detect": [
        "spring-boot"
      ]
    },
    {
      "id": "react",
      "group": "profile",
      "label": "React",
      "description": "Components, hooks, state and effects, accessibility, Testing Library",
      "detect": [
        "\"react\""
      ]
    },
    {
      "id": "node-api",
      "group": "profile",
      "label": "Node.js API",
      "description": "Thin handlers, validation, async errors, event loop, security, HTTP tests",
      "detect": [
        "\"express\"",
        "\"fastify\"",
        "@nestjs/core",
        "\"koa\""
      ]
    },
    {
      "id": "junit5",
      "group": "framework",
      "label": "JUnit 5",
      "language": "Java / Kotlin",
      "requires": "tester",
      "detect": [
        "junit-jupiter",
        "spring-boot-starter-test"
      ]
    },
    {
      "id": "testng",
      "group": "framework",
      "label": "TestNG",
